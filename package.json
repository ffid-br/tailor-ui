{
  "name": "@ffid-br/tailor-ui",
  "private": false,
  "version": "0.1.2",
  "description": "Primitivos de marca Tailor.ia em React: loader, intro, transição de login e lockup.",
  "type": "module",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "style": "dist/style.css",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./theme.css": "./dist/theme.css",
    "./dist/style.css": "./dist/style.css",
    "./dist/theme.css": "./dist/theme.css",
    "./tailor-logo.png": "./dist/tailor-logo.png",
    "./tailor-logo-branco.png": "./dist/tailor-logo-branco.png"
  },
  "scripts": {
    "build": "vite build && cp src/styles/style.css src/styles/theme.css src/assets/*.png dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "framer-motion": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "framer-motion": "^12.6.3",
    "jsdom": "^29.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "tailor",
    "design-system",
    "loader",
    "framer-motion"
  ],
  "author": "FFID",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ffid-br/tailor-ui"
  }
}
